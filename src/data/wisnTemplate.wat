    <dictionary id="availableWorkingTimeIndicator" name="Available Working Time Indicator">
      <fields>
        <field id="group" name="Available Working Time Indicators Group" type="STRING" />
        <field id="function" name="Function" type="STRING" />
        <field id="min" name="min" type="STRING" />
        <field id="max" name="min" type="STRING" />
      </fields>
      <elements>
        <element id="F0" name="Working Days Per Week">
          <value key="group" value="0" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="7" />
        </element>
        <element id="F1" name="Working Hours Per Day">
          <value key="group" value="0" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="24" />
        </element>
        <element id="F2" name="Annual Leave">
          <value key="group" value="1" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="365" />
        </element>
        <element id="F3" name="Public Holidays">
          <value key="group" value="1" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="356" />
        </element>
        <element id="F4" name="Sick Leave">
          <value key="group" value="1" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="356" />
        </element>
        <element id="F5" name="Special No Notice Leave">
          <value key="group" value="1" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="356" />
        </element>
        <element id="F6" name="Training Days Per Year">
          <value key="group" value="1" />
          <value key="function" value="" />
          <value key="min" value="0" />
          <value key="max" value="356" />
        </element>
        <element id="F7" name="Non - Working Days">
          <value key="group" value="2" />
          <value key="function" value="F2 + F3 + F4 + F5 + F6" />
          <value key="min" value="" />
          <value key="max" value="" />
        </element>
        <element id="F8" name="Non - Working Weeks">
          <value key="group" value="2" />
          <value key="function" value="F7 / F0" />
          <value key="min" value="" />
          <value key="max" value="" />
        </element>
        <element id="F9" name="Working Weeks">
          <value key="group" value="2" />
          <value key="function" value="52 - F8" />
          <value key="min" value="" />
          <value key="max" value="" />
        </element>
        <element id="FA" name="Working Days">
          <value key="group" value="2" />
          <value key="function" value="F9 * F0" />
          <value key="min" value="" />
          <value key="max" value="" />
        </element>
        <element id="FB" name="No of Hours">
          <value key="group" value="2" />
          <value key="function" value="FA * F1" />
          <value key="min" value="" />
          <value key="max" value="" />
        </element>
      </elements>
    </dictionary>
